---
import PreviewPanel from "../components/PreviewPanel.vue";
import "../styles/global.scss";

const work = {
  description: "公開前の制作物",
  producedAt: "2026-09-18",
  createdAt: "2026-09-22T12:00:00+09:00",
  publishAt: "2026-10-01T18:00:00+09:00",
  status: "scheduled" as const,
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Preview | sasanoha.dev</title>
  </head>
  <body>
    <main>
      <header>
        <p class="meta">preview surface</p>
        <h1>作品</h1>
        <p class="lead">
          この画面は <code>preview.sasanoha.dev</code> から表示する想定です。
          公開前のアイテムをサイト本体の見た目で確認します。
        </p>
      </header>

      <section>
        <article class="card">
          <strong>{work.description}</strong>
          <p>制作日時: {work.producedAt}</p>
          <p class="meta">公開前のdraft / scheduled data</p>
        </article>
      </section>
    </main>

    <PreviewPanel
      client:load
      status={work.status}
      producedAt={work.producedAt}
      createdAt={work.createdAt}
      publishAt={work.publishAt}
      referenceMode={true}
    />
  </body>
</html>
