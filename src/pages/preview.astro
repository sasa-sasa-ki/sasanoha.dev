---
import "../styles/global.scss";

const work = {
  description: "公開前の制作物",
  producedAt: "2026-09-18",
  createdAt: "2026-09-22T12:00:00+09:00",
  publishAt: "2026-10-01T18:00:00+09:00",
  status: "scheduled" as const,
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Preview | sasanoha.dev</title>
  </head>
  <body>
    <main>
      <header>
        <p class="meta">preview surface</p>
        <h1>作品</h1>
        <p class="lead">
          この画面は <code>preview.sasanoha.dev</code> から表示する想定です。
          公開前のアイテムをサイト本体の見た目で確認します。
        </p>
      </header>

      <section>
        <article class="card">
          <strong data-sasanoha-bind="description">{work.description}</strong>
          <p>制作日時: <span data-sasanoha-bind="producedAt">{work.producedAt}</span></p>
          <p class="meta">公開前のdraft / scheduled data</p>
        </article>
      </section>
    </main>

    <script is:inline src="/admin/preview/overlay.js"></script>
  </body>
</html>
