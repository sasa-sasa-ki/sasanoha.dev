{
  "name": "sasanoha.dev",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && npm test",
    "test": "node --test test/*.test.ts",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "cms:apply": "sasanoha apply",
    "cms:plan": "sasanoha deploy --plan",
    "cms:deploy": "sasanoha deploy --yes",
    "deploy:site": "npm run build && wrangler deploy",
    "deploy": "npm run cms:apply && npm run cms:deploy && npm run deploy:site"
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.1",
    "astro": "^7.0.6",
    "sass": "^1.101.0",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.13.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.130.0"
  }
}
