{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sasanoha-dev-reference",
  "compatibility_date": "2026-09-22",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "services": [
    {
      "binding": "CMS",
      "service": "sasanoha-cms"
    }
  ],
  "routes": [
    {
      "pattern": "sasanoha.dev",
      "custom_domain": true
    },
    {
      "pattern": "preview.sasanoha.dev",
      "custom_domain": true
    }
  ]
}
